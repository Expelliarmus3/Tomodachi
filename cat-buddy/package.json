{
  "name": "cat-buddy",
  "version": "1.0.0",
  "description": "Desktop pet companion",
  "main": "main.js",
  "scripts": {
    "start": "electron . --ozone-platform=x11 --disable-gpu",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.tomodachi.catbuddy",
    "productName": "Momo",
    "win": {
      "target": "nsis",
      "icon": "assets/Kitty.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": "always"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1"
  }
}